---
import StatusDot from './StatusDot.astro';
import type { Project } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  project: Project;
  variant?: 'grid' | 'compact' | 'featured';
}
const { project, variant = 'grid' } = Astro.props;
const { title, description, role, highlight, techStack, status, category, startDate, date } = project.data;
const href = url(`/projects/${project.id}`);
const isCompact = variant === 'compact';
const displayDate = startDate || date;
---

<a
  href={href}
  class:list={['project-card', { compact: isCompact }]}
  data-category={category}
>
  {
    isCompact ? (
      <>
        <div class="compact-head">
          <StatusDot status={status} withLabel={false} />
          <span class="title">{title}</span>
          <span class="stack mono">{techStack.slice(0, 4).join(' · ')}</span>
          {displayDate && <span class="date mono">{displayDate}</span>}
        </div>
        <p class="compact-desc">{description}</p>
      </>
    ) : (
      <>
        <div class="card-top">
          <div class="card-meta">
            <StatusDot status={status} withLabel={false} />
            <span class="role mono">{role || category}</span>
          </div>
          <div class="card-right">
            {displayDate && <span class="date mono">{displayDate}</span>}
            <span class="arrow mono" aria-hidden="true">↗</span>
          </div>
        </div>

        <h3 class="title">{title}</h3>
        <p class="desc">{description}</p>

        {highlight && <div class="highlight mono">{highlight}</div>}

        {techStack.length > 0 && (
          <div class="tech-row">
            {techStack.slice(0, 4).map((tech) => (
              <span class="tech-pill mono">{tech}</span>
            ))}
          </div>
        )}
      </>
    )
  }
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    text-decoration: none;
    transition: border-color var(--transition-base),
      background var(--transition-base);
    min-width: 0;
  }
  .project-card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-hover);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .card-meta > :global(.status) {
    align-self: center;
  }
  .role {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-right {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }
  .date {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
  .arrow {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .project-card:hover .arrow {
    color: var(--color-accent);
    transform: translate(1px, -1px);
  }
  .title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text);
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }
  .desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .highlight {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--space-1);
  }
  .tech-pill {
    font-size: 11px;
    color: var(--color-text-tertiary);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 9px;
    white-space: nowrap;
  }

  /* Compact variant */
  .project-card.compact {
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    margin: 4px 0;
  }
  .compact-head {
    display: grid;
    grid-template-columns: 16px 1fr auto auto;
    align-items: baseline;
    gap: var(--space-4);
  }
  .compact-head > :global(.status) {
    align-self: center;
  }
  .project-card.compact .title {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }
  .stack {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 300px;
  }
  .compact-desc {
    margin: 0;
    padding-left: calc(16px + var(--space-4));
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .project-card {
      padding: var(--space-4);
    }
    .compact-head {
      grid-template-columns: 16px 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-1) var(--space-3);
    }
    .stack {
      grid-row: 2;
      grid-column: 2;
      max-width: none;
      white-space: normal;
    }
    .compact-head .date {
      display: none;
    }
    .compact-desc {
      padding-left: calc(16px + var(--space-3));
      white-space: normal;
    }
  }
</style>
