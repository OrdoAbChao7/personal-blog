---
import StatusDot from './StatusDot.astro';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  variant?: 'compact' | 'featured';
}
const { project, variant = 'featured' } = Astro.props;
const { title, description, techStack, status, category, startDate } = project.data;
const href = `/projects/${project.id}`;
---

<a href={href} class="project-item">
  <StatusDot status={status} withLabel={false} />
  <span class="title">{title}</span>
  <span class="stack mono">
    {techStack.slice(0, 4).join(' · ')}
  </span>
  {startDate && <span class="date mono">{startDate}</span>}
</a>

<style>
  .project-item {
    display: grid;
    grid-template-columns: 16px 1fr auto auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid transparent;
    transition: border-color var(--transition-fast),
      background var(--transition-fast);
    text-decoration: none;
  }
  .project-item:hover {
    border-left-color: var(--color-accent);
    background: var(--color-bg-subtle);
  }
  /* StatusDot 占第一列，但要对齐到 title 的 baseline */
  .project-item > :global(.status) {
    align-self: center;
  }
  .title {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-normal);
    min-width: 0;
  }
  .project-item:hover .title {
    color: var(--color-accent-hover);
  }
  .stack {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }
  .date {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .project-item {
      grid-template-columns: 16px 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-1) var(--space-3);
      padding: var(--space-3) var(--space-3);
    }
    .project-item > :global(.status) {
      grid-row: 1;
      grid-column: 1;
    }
    .title {
      grid-row: 1;
      grid-column: 2;
    }
    .stack {
      grid-row: 2;
      grid-column: 2;
      max-width: none;
      white-space: normal;
    }
    .date {
      display: none;
    }
  }
</style>
