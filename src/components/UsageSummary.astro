---
import { usage, compact, integer, cost, updatedAt } from '../lib/usage';
import { url } from '../lib/url';
interface Props { compactView?: boolean }
const { compactView = false } = Astro.props;
const stats = [
  { key: 'tokens', label: '累计 Token', value: `${(usage.summary.totalTokens / 100_000_000).toFixed(2)} 亿`, exact: integer(usage.summary.totalTokens) },
  { key: 'requests', label: '累计请求', value: integer(usage.summary.requests) },
  { key: 'cache', label: '缓存命中率', value: `${(usage.summary.cacheHitRate * 100).toFixed(1)}%` },
  { key: 'cacheMiss', label: '缓存未命中', value: compact(usage.summary.cacheMissTokens ?? usage.summary.inputTokens ?? 0), exact: integer(usage.summary.cacheMissTokens ?? usage.summary.inputTokens ?? 0) },
  { key: 'cost', label: '估算 API 成本', value: cost(usage.summary.estimatedCostUsd) },
];
---
<section class:list={['usage-summary', { compact: compactView }]} aria-label="Token usage">
  {compactView && (
    <header>
      <h2 data-i18n="usage.title">Token 用量</h2>
      <a href={url('/usage/')}>
        <span data-i18n="usage.view">查看统计</span>
        <svg class="link-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>
  )}
  <dl class="metrics">
    {stats.map(stat => (
      <div class="metric">
        <dt data-i18n={`usage.${stat.key}`}>{stat.label}</dt>
        <dd class="tabular" title={stat.exact}>{stat.value}</dd>
      </div>
    ))}
  </dl>
  <p class="updated" data-i18n="usage.source">数据来源：本机逐条调用记录，含网关与各 Agent 会话上报</p>
  {compactView && (
    <p class="updated">
      <span data-i18n="usage.updated">数据更新于</span> <time datetime={usage.generatedAt}>{updatedAt}</time> · UTC+8
    </p>
  )}
</section>
<style>
  .usage-summary { width: 100%; }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: var(--space-4);
  }
  h2 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  header a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }
  header a:hover {
    color: var(--color-accent-hover);
  }
  .link-arrow {
    transition: transform var(--transition-fast);
  }
  header a:is(:hover, :focus-visible) .link-arrow {
    transform: translate(1px, -1px);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .metric {
    padding: 18px 16px;
    background: var(--color-bg-elevated);
    min-width: 0;
  }
  dt {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    margin-bottom: 8px;
  }
  dd {
    font-size: clamp(18px, 2.4vw, 24px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .updated {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-top: 10px;
  }
  .compact { padding-top: var(--space-3); }
  .compact .metric { padding: 14px 16px; background: var(--color-bg-elevated); }
  .compact dd { font-size: 20px; }
  @media (max-width: 820px) {
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metric { padding: 14px; }
    .metric:last-child { grid-column: 1 / -1; }
  }
</style>
