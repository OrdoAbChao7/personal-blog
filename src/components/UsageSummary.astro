---
import { usage, integer, cost, updatedAt } from '../lib/usage';
import { url } from '../lib/url';
interface Props { compactView?: boolean }
const { compactView = false } = Astro.props;
const stats = [
  { key: 'tokens', label: '累计 Token', value: `${(usage.summary.totalTokens / 100_000_000).toFixed(2)} 亿`, exact: integer(usage.summary.totalTokens) },
  { key: 'requests', label: '累计请求', value: integer(usage.summary.requests) },
  { key: 'cache', label: '缓存命中率', value: `${(usage.summary.cacheHitRate * 100).toFixed(1)}%` },
  { key: 'cost', label: '估算 API 成本', value: cost(usage.summary.estimatedCostUsd) },
];
---
<section class:list={['usage-summary', { compact: compactView }]} aria-label="Token usage">
  {compactView && <header><h2 data-i18n="usage.title">Token 用量</h2><a href={url('/usage/')} data-i18n="usage.view">查看统计 ↗</a></header>}
  <dl class="metrics">
    {stats.map(stat => <div class="metric"><dt data-i18n={`usage.${stat.key}`}>{stat.label}</dt><dd title={stat.exact}>{stat.value}</dd></div>)}
  </dl>
  <p class="updated" data-i18n="usage.source">数据来源于本机 CC Switch</p>
  {compactView && <p class="updated"><span data-i18n="usage.updated">数据更新于</span> <time datetime={usage.generatedAt}>{updatedAt}</time> · UTC+8</p>}
</section>
<style>
  .usage-summary { width: 100%; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  h2 { font-size: var(--text-sm); font-weight: 500; }
  header a { font-size: var(--text-xs); color: var(--color-accent); }
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .metric { padding: 20px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-elevated); min-width: 0; }
  dt { color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: 10px; }
  dd { font-size: clamp(22px, 3vw, 30px); font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.2; overflow-wrap: anywhere; }
  .updated { font-size: var(--text-xs); color: var(--color-text-tertiary); margin-top: 12px; }
  .compact { padding-top: 32px; }
  .compact .metric { padding: 16px; background: var(--color-bg-subtle); }
  .compact dd { font-size: 22px; }
  @media (max-width: 640px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } .metric { padding: 16px; } }
</style>
