---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { url } from '../lib/url';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: url('/'), label: '首页', key: 'home' },
  { href: url('/projects'), label: '项目', key: 'projects' },
  { href: url('/engineering'), label: '工程', key: 'engineering' },
  { href: url('/thinking'), label: '思考', key: 'thinking' },
  { href: url('/about'), label: '关于', key: 'about' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href={url('/')} class="brand">
      <span class="brand-mark mono">JJ</span>
      <span class="brand-name">Lab</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links" aria-label="主导航">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={active === link.key ? 'page' : undefined}
              class:list={['nav-link', { active: active === link.key }]}
              data-i18n={`nav.${link.key}`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <span class="nav-sep" aria-hidden="true">·</span>
      <LangToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
  }
  .nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }
  .brand-name {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-links {
    display: flex;
    gap: var(--space-1);
  }
  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), background var(--transition-fast);
    padding: 7px 12px;
    border-radius: var(--radius-full);
    position: relative;
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
  }
  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-muted);
  }
  .nav-sep {
    color: var(--color-border-strong);
    font-size: var(--text-sm);
    user-select: none;
  }
  @media (max-width: 768px) {
    .nav-links {
      gap: 2px;
    }
    .nav-link[data-i18n='nav.home'] {
      display: none;
    }
    .brand-name {
      display: none;
    }
    .nav-right { display: contents; }
    .nav-inner {
      display: grid;
      grid-template-columns: 1fr auto auto;
      padding: 12px 16px;
      gap: 8px;
    }
    .nav-links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    .nav-link { padding: 8px; font-size: 13px; }
    .nav-sep { display: none; }
  }
</style>
