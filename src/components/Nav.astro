---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { url } from '../lib/url';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: url('/'), label: '首页', key: 'home' },
  { href: url('/projects'), label: '项目', key: 'projects' },
  { href: url('/engineering'), label: '工程', key: 'engineering' },
  { href: url('/research'), label: '研究', key: 'research' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href={url('/')} class="brand">
      <span class="brand-mark mono">JJ</span>
      <span class="brand-name">Lab</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={['nav-link', { active: active === link.key }]}
              data-i18n={`nav.${link.key}`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <span class="nav-sep" aria-hidden="true">·</span>
      <LangToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }
  .brand-mark {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }
  .brand-name {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-links {
    display: flex;
    gap: var(--space-5);
  }
  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: 0;
    position: relative;
  }
  .nav-link:hover {
    color: var(--color-text);
  }
  .nav-link.active {
    color: var(--color-text);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--color-text);
  }
  .nav-sep {
    color: var(--color-border-strong);
    font-size: var(--text-sm);
    user-select: none;
  }
  @media (max-width: 640px) {
    .nav-links {
      gap: var(--space-4);
    }
    .brand-name {
      display: none;
    }
    .nav-right {
      gap: var(--space-3);
    }
  }
</style>
