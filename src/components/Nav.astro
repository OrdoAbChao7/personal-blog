---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { url } from '../lib/url';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: url('/'), label: '首页', key: 'home' },
  { href: url('/projects'), label: '项目', key: 'projects' },
  { href: url('/engineering'), label: '工程', key: 'engineering' },
  { href: url('/thinking'), label: '思考', key: 'thinking' },
  { href: url('/usage'), label: 'Token 用量', key: 'usage' },
  { href: url('/about'), label: '关于', key: 'about' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href={url('/')} class="brand">
      <span class="brand-mark mono">JJ</span>
      <span class="brand-name">Lab</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links" aria-label="主导航">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={active === link.key ? 'page' : undefined}
              class:list={['nav-link', { active: active === link.key }]}
              data-i18n={`nav.${link.key}`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <span class="nav-sep" aria-hidden="true">/</span>
      <div class="nav-utils">
        <LangToggle />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    background: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .brand-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), background var(--transition-fast);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
  }
  .nav-link.active {
    color: var(--color-text);
    background: var(--color-bg-hover);
    font-weight: 500;
  }
  .nav-sep {
    color: var(--color-border-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    user-select: none;
  }
  .nav-utils {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 900px) {
    .nav-link[data-i18n='nav.home'] {
      display: none;
    }
    .nav-right {
      display: contents;
    }
    .nav-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      padding: 10px 16px;
      gap: 8px;
    }
    .nav-utils {
      justify-self: end;
    }
    .nav-links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      flex-wrap: wrap;
      border-top: 1px solid var(--color-border);
      padding-top: 8px;
    }
    .nav-link {
      padding: 6px 8px;
      font-size: 13px;
    }
    .nav-sep {
      display: none;
    }
  }
</style>
