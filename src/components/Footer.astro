---
import { getProjects, getThinking, getEngineering } from '../lib/content';
import { url } from '../lib/url';

const year = new Date().getFullYear();

const [projects, thinking, engineering] = await Promise.all([
  getProjects(),
  getThinking(),
  getEngineering(),
]);

const projectCount = projects.length;
const postCount = thinking.length + engineering.length;

// 写作起始年：取所有内容中最早的 date 年份
const allDates = [
  ...projects.map((p) => p.data.date),
  ...thinking.map((p) => p.data.date),
  ...engineering.map((p) => p.data.date),
].filter(Boolean);
const startYear = allDates.length
  ? Math.min(...allDates.map((d) => Number(d.slice(0, 4))))
  : year;
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-stats mono">
      <span>{postCount} posts</span>
      <span class="sep">·</span>
      <span>{projectCount} projects</span>
      <span class="sep">·</span>
      <span>since {startYear}</span>
    </div>
    <div class="footer-meta mono">
      <a href={url('/about')}>About</a>
      <span class="sep">·</span>
      <a href={url('/now')}>Now</a>
      <span class="sep">·</span>
      <a href={url('/contact')}>Contact</a>
      <span class="sep">·</span>
      <span>© {year} JJ</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-8);
  }
  .footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-stats,
  .footer-meta {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .footer-meta a:hover {
    color: var(--color-text);
  }
  .sep {
    color: var(--color-border-strong);
  }
  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
