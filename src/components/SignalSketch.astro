---
// Decorative optical path / signal graph. No external assets or client runtime.
---
<svg class="signal-sketch" viewBox="0 0 300 128" fill="none" aria-hidden="true" focusable="false">
  <g class="guides" stroke="currentColor" stroke-width=".8">
    <path d="M12 102H288M38 14V114M262 14V114" />
    <path d="M12 26H288M12 64H288" stroke-dasharray="2 6" />
    <path d="M34 22H42M38 18V26M258 106H266M262 102V110" />
  </g>
  <g class="structure" stroke="currentColor" stroke-width="1.1">
    <path d="M16 64H78M106 64H166M210 64H284" />
    <path d="M92 24C72 42 72 86 92 104C112 86 112 42 92 24Z" />
    <path d="M108 64L164 36L208 64L164 94L108 64Z" />
    <path d="M164 36V94M208 64L250 36M208 64L250 94" />
    <circle cx="250" cy="36" r="5" /><circle cx="250" cy="94" r="5" />
  </g>
  <path class="signal" d="M16 64H38C45 64 45 50 52 50S59 78 66 78S73 64 80 64H108L164 36L208 64H284" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <g class="nodes" fill="currentColor">
    <circle cx="38" cy="64" r="2.5" /><circle cx="164" cy="36" r="3" /><circle cx="208" cy="64" r="3" />
  </g>
  <circle class="pulse" cx="208" cy="64" r="7" stroke="currentColor" stroke-width="1" />
</svg>
<style>
  .signal-sketch { width: 100%; height: auto; display: block; color: var(--color-text-tertiary); }
  .guides { opacity: .22; }
  .structure { opacity: .46; }
  .signal, .nodes, .pulse { color: var(--color-accent); }
  .signal { opacity: .7; stroke-dasharray: 420; stroke-dashoffset: 0; animation: trace-in 2.4s ease-out both; }
  .nodes { opacity: .8; }
  .pulse { opacity: .25; transform-origin: 208px 64px; animation: signal-pulse 5s ease-in-out infinite; }
  @keyframes trace-in { from { stroke-dashoffset: 420; opacity: .15; } to { stroke-dashoffset: 0; opacity: .7; } }
  @keyframes signal-pulse { 0%, 100% { transform: scale(.85); opacity: .12; } 50% { transform: scale(1.3); opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .signal, .pulse { animation: none; } }
</style>
