---
interface Props {
  status: 'idea' | 'building' | 'shipped' | 'archived';
  withLabel?: boolean;
}
const { status, withLabel = true } = Astro.props;

const labelMap = {
  idea: 'Idea',
  building: 'Building',
  shipped: 'Shipped',
  archived: 'Archived',
};
---

<span class="status">
  <span class:list={['dot', `dot-${status}`]}></span>
  {withLabel && <span class="label">{labelMap[status]}</span>}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-building {
    background: var(--color-building);
  }
  .dot-shipped {
    background: var(--color-shipped);
  }
  .dot-archived {
    background: var(--color-archived);
  }
  .dot-idea {
    background: var(--color-idea);
  }
</style>
