---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import SidePhotos from '../components/SidePhotos.astro';
import UsageSummary from '../components/UsageSummary.astro';
import { getProjects, getThinking, getEngineering } from '../lib/content';
import { url } from '../lib/url';

const buildingProjects = (await getProjects({ featured: true })).slice(0, 4);
const latestThinking = (await getThinking()).slice(0, 3);
const latestEngineering = (await getEngineering()).slice(0, 3);
---

<BaseLayout active="home">
  <div class="home-wrapper">
    <SidePhotos />
    <article class="home container">
    <!-- 1. 自我介绍 -->
    <section class="intro">
      <h1 class="greeting" data-i18n="home.greeting">Hi, 我是 JJ。</h1>
      <p class="intro-text" data-i18n="home.intro">
        武汉理工大学光电信息科学与工程本科生，2028 届。聚焦 Agent/RAG 开发与系统可靠性，向 n8n、DeepTutor 等开源项目贡献 7 个合并 PR，记录从真实工程协作到系统评测的实践。
      </p>
      <p class="stack-line">
        <span class="stack-label mono" data-i18n="home.stackLabel">当前栈</span>
        <span class="stack-value mono">Python · Multi-Agent · RAG · TypeScript · Vitest · ESP32</span>
      </p>
    </section>

    <UsageSummary compactView />

    <!-- 2. 正在构建 -->
    <section class="block">
      <header class="block-head">
        <h2 class="block-title" data-i18n="home.currently">代表项目与贡献</h2>
        <span class="block-sub mono" data-i18n="home.currentlySub">（更新于 2026.10.16）</span>
      </header>
      {
        buildingProjects.length === 0 ? (
          <p class="empty" data-i18n="home.empty">暂无内容</p>
        ) : (
          <div class="list">
            {buildingProjects.map((p) => (
              <ProjectCard project={p} variant="compact" />
            ))}
          </div>
        )
      }
    </section>

    <!-- 3. 近期写作 -->
    <section class="block">
      <header class="block-head">
        <h2 class="block-title" data-i18n="home.writing">近期写作</h2>
      </header>

      <div class="writing-group">
        <h3 class="group-label mono" data-i18n="home.writingThinking">思考</h3>
        <div class="list">
          {
            latestThinking.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestThinking.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/thinking/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>

      <div class="writing-group">
        <h3 class="group-label mono" data-i18n="home.writingEngineering">工程</h3>
        <div class="list">
          {
            latestEngineering.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestEngineering.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/engineering/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>
    </section>
  </article>
  </div>
</BaseLayout>

<style>
  .home-wrapper {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
  }

  .home {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* 1. 自我介绍 */
  .intro {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }
  .greeting {
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }
  .intro-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }
  .stack-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--text-sm);
  }
  .stack-label {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .stack-value {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  /* 2/3. 区块 */
  .block {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .block:last-child {
    border-bottom: none;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .block-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .block-sub {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  /* 列表容器：仅顶/底分隔线，项目间无卡片 */
  .list {
    display: flex;
    flex-direction: column;
  }

  .empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    padding: var(--space-3) 0;
  }

  /* 写作分组 */
  .writing-group {
    margin-bottom: var(--space-6);
  }
  .writing-group:last-child {
    margin-bottom: 0;
  }
  .group-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
    padding-left: var(--space-4);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
    .intro { padding: var(--space-5); }
    .greeting {
      font-size: var(--text-xl);
    }
    .group-label {
      padding-left: var(--space-3);
    }
  }
</style>
