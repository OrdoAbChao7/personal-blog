---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import UsageSummary from '../components/UsageSummary.astro';
import { getProjects, getThinking, getEngineering } from '../lib/content';
import { usage } from '../lib/usage';
import { url } from '../lib/url';

const buildingProjects = (await getProjects({ featured: true })).slice(0, 4);
const latestThinking = (await getThinking()).slice(0, 3);
const latestEngineering = (await getEngineering()).slice(0, 3);
const totalTokensBillion = `${(usage.summary.totalTokens / 1_000_000_000).toFixed(2)}B`;

const ossHighlights = [
  {
    repo: 'HKUDS / DeepTutor',
    repoUrl: 'https://github.com/HKUDS/DeepTutor',
    badge: 'Core Maintainer',
    badgeI18n: 'home.ossDeepTutorRole',
    badgeAccent: true,
    desc: '主导或修复多轮订正防遗忘幂等锁、推理模型探活 token 预算及 Windows 跨平台进程探测。',
    descI18n: 'home.ossDeepTutorDesc',
    prs: [
      { label: '#1794', href: 'https://github.com/HKUDS/DeepTutor/pull/1794' },
      { label: '#1694', href: 'https://github.com/HKUDS/DeepTutor/pull/1694' },
      { label: '#1690', href: 'https://github.com/HKUDS/DeepTutor/pull/1690' },
    ],
  },
  {
    repo: 'n8n-io / n8n',
    repoUrl: 'https://github.com/n8n-io/n8n',
    badge: 'Workflow Platform',
    badgeI18n: 'home.ossN8nRole',
    badgeAccent: false,
    desc: '修复 Splunk 节点在 Continue On Fail 模式下的错误对象丢失与 pairedItem 关联异常，补充 HTTP 回归测试。',
    descI18n: 'home.ossN8nDesc',
    prs: [{ label: '#40368', href: 'https://github.com/n8n-io/n8n/pull/40368' }],
  },
  {
    repo: 'morluto / rea',
    repoUrl: 'https://github.com/morluto/rea',
    badge: 'Agentic Reverse Eng.',
    badgeI18n: 'home.ossReaRole',
    badgeAccent: false,
    desc: '将畸形残差图错误分类从 unreadable_output 修正为 invalid_input，暴露 Evidence ID 与恢复路径。',
    descI18n: 'home.ossReaDesc',
    prs: [{ label: '#6321', href: 'https://github.com/morluto/rea/pull/6321' }],
  },
];
---

<BaseLayout active="home">
  <article class="home container">
    <!-- 1. Hero：左定位 + 右 2×2 可验证指标矩阵 -->
    <section class="hero">
      <div class="status-strip mono">
        <a
          href="https://github.com/HKUDS/DeepTutor"
          target="_blank"
          rel="noopener noreferrer"
          class="status-link"
        >
          <span class="live-dot" aria-hidden="true"></span>
          <span data-i18n="home.pillMaintainer">HKUDS / DeepTutor · 核心维护者</span>
        </a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={url('/projects/open-source-contributions')} class="status-link" data-i18n="home.pillPrs">
          7 个上游项目 · 10 个已合并 PR
        </a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="status-muted" data-i18n="home.pillSchool">武汉理工大学 · 2028 届</span>
      </div>

      <div class="hero-grid">
        <div class="hero-main">
          <h1 class="greeting" data-i18n="home.greeting">Hi, I'm JJ.</h1>
          <p class="intro-lead" data-i18n="home.introSummary">
            专注 AI Agent、Hybrid RAG 与系统可靠性。目前担任 HKUDS / DeepTutor 核心维护者，并向 n8n、rea、PixelRAG 等开源项目合并 10 个 PR。
          </p>
          <p class="intro-sub" data-i18n="home.introBlog">
            这里记录可验证的工程架构、开源实践、端侧硬件原型与持续思考。
          </p>
          <div class="cta-row">
            <a href={url('/projects')} class="cta cta-primary" data-i18n="home.ctaProjects">代表项目 →</a>
            <a
              href="https://github.com/OrdoAbChao7"
              target="_blank"
              rel="noopener noreferrer"
              class="cta"
              data-i18n="home.ctaGithub"
            >
              GitHub ↗
            </a>
            <a href={url('/contact')} class="cta" data-i18n="home.ctaContact">联系我</a>
          </div>
        </div>

        <div class="proof-matrix" aria-label="核心工程凭据">
          <a
            href="https://github.com/HKUDS/DeepTutor"
            target="_blank"
            rel="noopener noreferrer"
            class="proof-cell"
          >
            <span class="proof-val">DeepTutor</span>
            <span class="proof-key mono" data-i18n="home.metricMaintainerLabel">Core Maintainer ↗</span>
          </a>
          <a href={url('/projects/open-source-contributions')} class="proof-cell">
            <span class="proof-val tabular">10 PRs</span>
            <span class="proof-key mono" data-i18n="home.metricPrsLabel">7 个上游仓库合并</span>
          </a>
          <a href={url('/projects/county-research-ai')} class="proof-cell">
            <span class="proof-val tabular">299</span>
            <span class="proof-key mono" data-i18n="home.metricTestsLabel">Pytest · 85% 覆盖率</span>
          </a>
          <a href={url('/usage/')} class="proof-cell">
            <span class="proof-val tabular">{totalTokensBillion}</span>
            <span class="proof-key mono" data-i18n="home.metricTokensLabel">Tokens 实时台账 ↗</span>
          </a>
        </div>
      </div>

      <div class="stack-bar">
        <span class="stack-label mono" data-i18n="home.stackLabel">STACK</span>
        <div class="stack-items mono">
          {
            ['Python', 'TypeScript', 'AI Agent', 'Hybrid RAG', 'Pydantic / pytest', 'ESP32 / TinyML'].map(
              (tech) => <code>{tech}</code>
            )
          }
        </div>
      </div>
    </section>

    <!-- 2. 开源与维护规格表 -->
    <section class="block">
      <header class="block-head">
        <div class="head-left">
          <h2 class="block-title" data-i18n="home.ossTitle">开源与维护</h2>
          <span class="block-sub mono tabular" data-i18n="home.ossSub">（7 仓库 · 10 PR）</span>
        </div>
        <a href={url('/projects/open-source-contributions')} class="head-link mono" data-i18n="home.ossViewAll">
          完整记录 →
        </a>
      </header>

      <div class="oss-table">
        <div class="oss-thead mono" aria-hidden="true">
          <span data-i18n="home.ossColRepo">REPOSITORY</span>
          <span data-i18n="home.ossColScope">CONTRIBUTION</span>
          <span data-i18n="home.ossColPrs">MERGED PRs</span>
        </div>
        {
          ossHighlights.map((item) => (
            <div class="oss-row">
              <div class="oss-repo-col">
                <a
                  href={item.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="oss-repo"
                >
                  {item.repo}
                </a>
                <span
                  class:list={['oss-badge', 'mono', { accent: item.badgeAccent }]}
                  data-i18n={item.badgeI18n}
                >
                  {item.badge}
                </span>
              </div>
              <p class="oss-desc" data-i18n={item.descI18n}>
                {item.desc}
              </p>
              <div class="oss-prs">
                {item.prs.map((pr) => (
                  <a
                    href={pr.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pr-chip mono tabular"
                  >
                    {pr.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 3. 代表项目网格 -->
    <section class="block">
      <header class="block-head">
        <div class="head-left">
          <h2 class="block-title" data-i18n="home.currently">代表项目</h2>
          <span class="block-sub mono tabular" data-i18n="home.currentlySub">（更新于 2026.11.28）</span>
        </div>
        <a href={url('/projects')} class="head-link mono" data-i18n="home.viewAll">
          全部 →
        </a>
      </header>
      {
        buildingProjects.length === 0 ? (
          <p class="empty" data-i18n="home.empty">暂无内容</p>
        ) : (
          <div class="project-grid">
            {buildingProjects.map((p, idx) => (
              <ProjectCard
                project={p}
                variant="grid"
                indexLabel={String(idx + 1).padStart(2, '0')}
              />
            ))}
          </div>
        )
      }
    </section>

    <!-- 4. 近期写作 -->
    <section class="block">
      <header class="block-head">
        <div class="head-left">
          <h2 class="block-title" data-i18n="home.writing">近期写作</h2>
        </div>
      </header>

      <div class="writing-group">
        <div class="group-head">
          <h3 class="group-label mono" data-i18n="home.writingThinking">思考</h3>
          <a href={url('/thinking')} class="group-link mono" data-i18n="home.viewAll">
            全部 →
          </a>
        </div>
        <div class="post-list">
          {
            latestThinking.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestThinking.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/thinking/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>

      <div class="writing-group">
        <div class="group-head">
          <h3 class="group-label mono" data-i18n="home.writingEngineering">工程</h3>
          <a href={url('/engineering')} class="group-link mono" data-i18n="home.viewAll">
            全部 →
          </a>
        </div>
        <div class="post-list">
          {
            latestEngineering.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestEngineering.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/engineering/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>
    </section>

    <!-- 5. Token 用量摘要 -->
    <section class="usage-block">
      <UsageSummary compactView />
    </section>
  </article>
</BaseLayout>

<style>
  .home {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 1060px) {
    .home {
      border-left: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
      padding-left: var(--space-7);
      padding-right: var(--space-7);
    }
  }

  /* 1. Hero */
  .hero {
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .status-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-5);
  }
  .status-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }
  .status-link:hover {
    color: var(--color-accent);
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-shipped);
    flex-shrink: 0;
  }
  .sep {
    color: var(--color-border-strong);
  }
  .status-muted {
    color: var(--color-text-tertiary);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: var(--space-6);
    align-items: stretch;
  }
  .hero-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .greeting {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
  }
  .intro-lead {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    max-width: 54ch;
    margin-bottom: var(--space-2);
  }
  .intro-sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 54ch;
    margin-bottom: var(--space-5);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 15px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: border-color var(--transition-fast),
      background var(--transition-fast),
      color var(--transition-fast);
  }
  .cta:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-hover);
  }
  .cta-primary {
    background: var(--color-btn-primary-bg);
    border-color: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
  }
  .cta-primary:hover {
    background: var(--color-btn-primary-hover);
    border-color: var(--color-btn-primary-hover);
    color: var(--color-btn-primary-text);
  }

  /* 右侧 2×2 指标矩阵 */
  .proof-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .proof-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    transition: background var(--transition-fast);
    min-width: 0;
  }
  .proof-cell:hover {
    background: var(--color-bg-subtle);
  }
  .proof-val {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1.15;
  }
  .proof-key {
    font-size: 11px;
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);
    overflow-wrap: anywhere;
  }
  .proof-cell:hover .proof-key {
    color: var(--color-accent);
  }

  /* Tech Stack 条 */
  .stack-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .stack-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }
  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .stack-items code {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 2px 8px;
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  /* 通用区块 */
  .block {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .head-left {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .block-title {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .block-sub {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .head-link,
  .group-link {
    font-size: var(--text-xs);
    color: var(--color-accent);
    white-space: nowrap;
  }
  .head-link:hover,
  .group-link:hover {
    color: var(--color-accent-hover);
  }

  /* 2. 开源规格表 */
  .oss-table {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    overflow: hidden;
  }
  .oss-thead {
    display: grid;
    grid-template-columns: 220px 1fr 180px;
    gap: var(--space-4);
    padding: 9px var(--space-4);
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }
  .oss-thead span:last-child {
    text-align: right;
  }
  .oss-row {
    display: grid;
    grid-template-columns: 220px 1fr 180px;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
  }
  .oss-row:last-child {
    border-bottom: none;
  }
  .oss-row:hover {
    background: var(--color-bg-subtle);
  }
  .oss-repo-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    min-width: 0;
  }
  .oss-repo {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .oss-repo:hover {
    color: var(--color-accent);
  }
  .oss-badge {
    font-size: 11px;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text-tertiary);
  }
  .oss-badge.accent {
    background: var(--color-accent-muted);
    border-color: transparent;
    color: var(--color-accent);
    font-weight: 500;
  }
  .oss-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
  .oss-prs {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .pr-chip {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-accent);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .pr-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }

  /* 3. 代表项目网格 */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* 4. 写作分组 */
  .writing-group {
    margin-bottom: var(--space-5);
  }
  .writing-group:last-child {
    margin-bottom: 0;
  }
  .group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .group-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }
  .post-list {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }
  .empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
  }

  .usage-block {
    padding-top: var(--space-5);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .oss-thead {
      display: none;
    }
    .oss-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .oss-prs {
      justify-content: flex-start;
    }
  }

  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .home {
      padding-top: var(--space-5);
      padding-bottom: var(--space-6);
    }
    .greeting {
      font-size: 2rem;
    }
  }
</style>
