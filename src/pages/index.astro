---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import SidePhotos from '../components/SidePhotos.astro';
import UsageSummary from '../components/UsageSummary.astro';
import SignalSketch from '../components/SignalSketch.astro';
import { getProjects, getThinking, getEngineering } from '../lib/content';
import { url } from '../lib/url';

const buildingProjects = (await getProjects({ featured: true })).slice(0, 4);
const latestThinking = (await getThinking()).slice(0, 3);
const latestEngineering = (await getEngineering()).slice(0, 3);
---

<BaseLayout active="home">
  <div class="home-wrapper">
    <SidePhotos />
    <article class="home container">
    <!-- 1. 自我介绍 -->
    <section class="intro">
      <div class="intro-heading">
        <h1 class="greeting" data-i18n="home.greeting">Hi, I'm JJ.</h1>
        <div class="intro-sketch"><SignalSketch /></div>
      </div>
      <p class="intro-text" data-i18n="home.education">武汉理工大学光电信息科学与工程专业，2028 届本科生。</p>
      <p class="intro-text"><span data-i18n="home.focusBefore">聚焦 </span><strong data-i18n="home.focus">AI Agent、RAG 与系统可靠性</strong><span data-i18n="home.contributionsBefore">，已向 </span><strong data-i18n="home.projects">n8n、DeepTutor</strong><span data-i18n="home.contributionsMiddle"> 等开源项目贡献 </span><strong data-i18n="home.contributions">7 个已合并 PR</strong><span data-i18n="home.focusAfter">，持续探索 AI 系统的工程实践与可靠性评测。</span></p>
      <p class="intro-text"><span data-i18n="home.blogBefore">这个博客是我的</span><strong data-i18n="home.blogPurpose">个人成长与思考记录</strong><span data-i18n="home.blogAfter">，在这里分享技术探索、项目实践、学习心得，以及对科技、商业与个人发展的思考。</span></p>
      <div class="stack-line">
        <span class="stack-label" data-i18n="home.stackLabel">Tech Stack</span>
        <div class="stack-value">
          {['Python', 'TypeScript', 'AI Agent', 'RAG', 'Vitest', 'FPGA', 'ESP32'].map((tech, index) => <><span aria-hidden="true" class:list={['stack-separator', { first: index === 0 }]}>·</span><code>{tech}</code></>)}
        </div>
      </div>
    </section>

    <UsageSummary compactView />

    <!-- 2. 正在构建 -->
    <section class="block">
      <header class="block-head">
        <span class="section-number mono" aria-hidden="true">01 /</span>
        <h2 class="block-title" data-i18n="home.currently">代表项目与贡献</h2>
        <span class="block-sub mono" data-i18n="home.currentlySub">（更新于 2026.10.16）</span>
      </header>
      {
        buildingProjects.length === 0 ? (
          <p class="empty" data-i18n="home.empty">暂无内容</p>
        ) : (
          <div class="list">
            {buildingProjects.map((p) => (
              <ProjectCard project={p} variant="compact" />
            ))}
          </div>
        )
      }
    </section>

    <!-- 3. 近期写作 -->
    <section class="block">
      <header class="block-head">
        <span class="section-number mono" aria-hidden="true">02 /</span>
        <h2 class="block-title" data-i18n="home.writing">近期写作</h2>
      </header>

      <div class="writing-group">
        <h3 class="group-label mono" data-i18n="home.writingThinking">思考</h3>
        <div class="list">
          {
            latestThinking.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestThinking.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/thinking/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>

      <div class="writing-group">
        <h3 class="group-label mono" data-i18n="home.writingEngineering">工程</h3>
        <div class="list">
          {
            latestEngineering.length === 0 ? (
              <p class="empty" data-i18n="home.empty">暂无内容</p>
            ) : (
              latestEngineering.map((p) => (
                <PostCard
                  title={p.data.title}
                  date={p.data.date}
                  tags={p.data.tags}
                  href={url(`/engineering/${p.id}`)}
                />
              ))
            )
          }
        </div>
      </div>
    </section>
  </article>
  </div>
</BaseLayout>

<style>
  .home-wrapper {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
  }

  .home {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* 1. 自我介绍 */
  .intro {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }
  .greeting {
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    margin-bottom: 0;
  }
  .intro-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .intro-sketch { width: 210px; flex-shrink: 0; }
  .intro-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }
  .stack-line {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--text-sm);
  }
  .stack-label {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .stack-value {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }
  .stack-value code { background: var(--color-bg-elevated); border: 1px solid var(--color-border); font-size: var(--text-xs); }
  .stack-separator { color: var(--color-text-tertiary); }
  .stack-separator.first { display: none; }
  .intro-text strong { color: var(--color-text); font-weight: 600; }

  /* 2/3. 区块 */
  .block {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .block:last-child {
    border-bottom: none;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .block-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .section-number { font-size: var(--text-xs); color: var(--color-text-tertiary); letter-spacing: .06em; }
  .block-sub {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  /* 列表容器：仅顶/底分隔线，项目间无卡片 */
  .list {
    display: flex;
    flex-direction: column;
  }

  .empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    padding: var(--space-3) 0;
  }

  /* 写作分组 */
  .writing-group {
    margin-bottom: var(--space-6);
  }
  .writing-group:last-child {
    margin-bottom: 0;
  }
  .group-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
    padding-left: var(--space-4);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
    .intro { padding: var(--space-5); }
    .intro-heading { gap: 8px; }
    .intro-sketch { width: 90px; }
    .greeting {
      font-size: var(--text-xl);
    }
    .group-label {
      padding-left: var(--space-3);
    }
  }
</style>
