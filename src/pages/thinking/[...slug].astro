---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { formatDate } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('thinking', ({ data }) => !data.draft);
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, category } = post.data;

const categoryLabel: Record<string, string> = {
  'ai-trend': 'AI Trend',
  society: 'Society',
  startup: 'Startup',
  'tech-analysis': 'Tech Analysis',
};

---

<BaseLayout active="thinking" title={`${title} · JJ Lab`} description={description}>
  <ReadingProgress />
  <article class="post-detail">
    <div class="post-layout">
      <div class="content">
        <a href={url('/thinking')} class="back mono">← Thinking</a>
        <header class="head">
          <div class="head-meta">
            <span class="eyebrow mono">{categoryLabel[category]}</span>
            <span class="date mono">{formatDate(date)}</span>
          </div>
          <h1>{title}</h1>
          {description && <p class="desc">{description}</p>}
          {
            tags.length > 0 && (
              <div class="tags">
                {tags.map((t) => (
                  <Tag text={t} />
                ))}
              </div>
            )
          }
        </header>
        <div class="prose">
          <Content />
        </div>
      </div>
      <TableOfContents headings={headings} />
    </div>
  </article>

</BaseLayout>

<style>
  .post-detail {
    padding: var(--space-7) 0;
  }
  .post-layout {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
  }
  .content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }
  .back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-5);
  }
  .back:hover {
    color: var(--color-accent);
  }
  .head {
    margin-bottom: var(--space-2);
  }
  .head-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .head h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-4);
  }
  @media (max-width: 640px) {
    .head h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
