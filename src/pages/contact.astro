---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileNav from '../components/ProfileNav.astro';

const email = 'dwjzca@gamil.com';
const github = 'https://github.com/OrdoAbChao7';
---

<BaseLayout active="about" title="Contact · JJ Lab" description="与 JJ 联系：GitHub 与电子邮件。">
  <main class="profile-page">
    <div class="profile-shell">
      <ProfileNav active="contact" />

      <header class="page-head">
        <span class="eyebrow mono">/contact</span>
        <h1>保持联系。</h1>
        <p>欢迎围绕 AI Agent、智能硬件、产业研究、开源项目或长期学习系统交流。</p>
      </header>

      <section class="contact-list" aria-label="联系方式">
        <a href={github} class="contact-item" target="_blank" rel="noopener noreferrer">
          <div>
            <span class="contact-label mono">GitHub</span>
            <strong>github.com/OrdoAbChao7</strong>
          </div>
          <span class="contact-arrow mono">↗</span>
        </a>
        <a href={`mailto:${email}`} class="contact-item">
          <div>
            <span class="contact-label mono">Email</span>
            <strong>{email}</strong>
          </div>
          <span class="contact-arrow mono">↗</span>
        </a>
      </section>

      <section class="note">
        <span class="note-label mono">Notes</span>
        <p>如果邮件客户端没有自动打开，可以复制邮箱地址后在常用邮件服务中联系我。</p>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .profile-page {
    padding: var(--space-7) 0;
  }
  .profile-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .page-head {
    margin-bottom: var(--space-7);
  }
  .eyebrow {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
  }
  .page-head p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  .contact-list {
    display: grid;
    border: 1px solid var(--color-border);
  }
  .contact-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
  }
  .contact-item:last-child {
    border-bottom: 0;
  }
  .contact-item:hover {
    background: var(--color-bg-subtle);
  }
  .contact-label {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }
  strong {
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .contact-arrow {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }
  .note {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }
  .note-label {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }
  .note p {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  @media (max-width: 640px) {
    .profile-shell {
      padding: 0 var(--space-4);
    }
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
