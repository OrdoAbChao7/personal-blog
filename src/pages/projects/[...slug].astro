---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import StatusDot from '../../components/StatusDot.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const {
  title,
  description,
  techStack,
  status,
  category,
  github,
  demo,
  startDate,
  endDate,
  date,
  gallery,
} = project.data;
const period = startDate
  ? `${startDate}${endDate ? ` → ${endDate}` : ' → now'}`
  : null;
---

<BaseLayout active="projects" title={`${title} · JJ Lab`} description={description}>
  <ReadingProgress />
  <article class="project-detail">
    <div class="post-layout">
      <div class="content">
      <a href={url('/projects')} class="back mono">← Projects</a>
      <header class="head">
        <div class="head-meta">
          <StatusDot status={status} />
          <span class="cat mono">{category}</span>
        </div>
        <h1>{title}</h1>
        <p class="desc">{description}</p>
        <div class="meta-grid">
          {
            period && (
              <div class="meta-item">
                <span class="label">周期</span>
                <span class="value mono">{period}</span>
              </div>
            )
          }
          <div class="meta-item">
            <span class="label">更新</span>
            <span class="value mono">{date}</span>
          </div>
          {
            github && (
              <a href={github} class="meta-link" target="_blank" rel="noopener">
                GitHub ↗
              </a>
            )
          }
          {
            demo && (
              <a href={demo} class="meta-link" target="_blank" rel="noopener">
                Demo ↗
              </a>
            )
          }
        </div>
        {
          techStack.length > 0 && (
            <div class="stack">
              <span class="stack-label mono">Stack</span>
              <div class="stack-tags">
                {techStack.map((t) => (
                  <Tag text={t} />
                ))}
              </div>
            </div>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
      {
        gallery && gallery.length > 0 && (
          <div class="project-gallery">
            <h2 class="gallery-title mono">Gallery</h2>
            <div class="gallery-grid">
              {gallery.map((img, index) => (
                <a href={url(img)} target="_blank" rel="noopener noreferrer" class="gallery-item">
                  <img src={url(img)} alt={`${title} gallery image ${index + 1}`} loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        )
      }
      </div>
      <TableOfContents headings={headings} />
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding: var(--space-7) 0;
  }
  .post-layout {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
  }
  .content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }
  .back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-5);
  }
  .back:hover {
    color: var(--color-accent);
  }
  .head {
    margin-bottom: var(--space-4);
  }
  .head-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .cat {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }
  .head h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
  .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: var(--space-5) 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }
  .value {
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .meta-link {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .stack {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .stack-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    padding-top: 4px;
  }
  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-gallery {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .gallery-title {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-4);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }
  .gallery-item {
    display: block;
    aspect-ratio: 4/3;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    transition: border-color var(--transition-fast);
  }
  .gallery-item:hover {
    border-color: var(--color-accent);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }
  .gallery-item:hover img {
    transform: scale(1.02);
  }
  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    }
    .head h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
