---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const count = projects.length;
---

<BaseLayout active="projects" title="Projects · JJ Lab">
  <section class="page-header container">
    <span class="eyebrow mono" data-i18n="projects.eyebrow">/projects</span>
    <h1 data-i18n="projects.title">项目</h1>
    <p class="sub" data-i18n="projects.sub">做过的东西。硬件、软件与研究的交叉实验。</p>
    <p class="stat mono">{count} <span data-i18n="projects.count">个</span></p>
  </section>

  <section class="page-body container">
    {
      count === 0 ? (
        <p class="empty" data-i18n="home.empty">暂无内容</p>
      ) : (
        <div class="list">
          {projects.map((p) => (
            <ProjectCard project={p} variant="featured" />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-7) 0 var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .eyebrow {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    margin: var(--space-2) 0;
  }
  .sub {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    max-width: 560px;
  }
  .stat {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .page-body {
    padding: var(--space-5) 0 var(--space-7);
  }
  .list {
    display: flex;
    flex-direction: column;
  }
  .list > :global(*) {
    border-bottom: 1px solid var(--color-border);
  }
  .list > :global(*:last-child) {
    border-bottom: none;
  }
  .empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }
</style>
