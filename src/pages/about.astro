---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileNav from '../components/ProfileNav.astro';
import { url } from '../lib/url';
---

<BaseLayout active="about" title="About · JJ Lab" description="JJ 的研究兴趣、构建方向与代表项目。">
  <main class="profile-page">
    <div class="profile-shell">
      <ProfileNav active="about" />

      <header class="page-head">
        <span class="eyebrow mono">/about</span>
        <h1>在系统的交叉地带构建与记录。</h1>
        <p>
          我是陈俊杰，武汉理工大学光电信息科学与工程本科生（2024.09—2028.06）。目前专注 Python Agent、RAG 检索评测与端侧 AI。
        </p>
      </header>

      <section class="section">
        <h2>教育与创新经历</h2>
        <p>
          年级前 20%，通过 CET-6。担任省级大学生创新创业训练计划项目“微光译语”负责人，负责总体方案、嵌入式开发与端侧部署；同时通过个人项目和开源二次开发实践 Agent 工具调用、状态管理、失败降级与离线评测。
        </p>
      </section>

      <section class="section">
        <h2>当前能力栈</h2>
        <div class="tag-grid mono" aria-label="技能关键词">
          <span>Python</span>
          <span>Pydantic / pytest</span>
          <span>LLM Agents</span>
          <span>ESP32</span>
          <span>TinyML</span>
          <span>NIR Sensing</span>
          <span>Playwright</span>
          <span>ChromaDB / RRF</span>
        </div>
      </section>

      <section class="section">
        <h2>代表项目</h2>
        <div class="project-list">
          <a href={url('/projects/county-research-ai')} class="project-item">
            <div>
              <span class="project-name">CountyResearchAI</span>
              <p>自研 Agent Runtime，输出带来源链接的研究初稿，保留状态与执行 Trace。</p>
            </div>
            <span class="project-arrow mono">→</span>
          </a>
          <a href={url('/projects/lingshan-rag')} class="project-item"><div><span class="project-name">灵小禅 · RAG</span><p>开源二次开发：混合检索、50 题事实评测与七组组件消融。</p></div><span class="project-arrow mono">→</span></a>
          <a href={url('/projects/courselm')} class="project-item"><div><span class="project-name">CourseLM</span><p>课程资料到复习讲义的 CLI 工作流，支持章节缓存与失败续跑。</p></div><span class="project-arrow mono">→</span></a>
          <a href={url('/projects/microglow-translate')} class="project-item">
            <div>
              <span class="project-name">MicroGlow Translate</span>
              <p>省级大创负责人：三路近红外采集、1D-CNN 与 ESP32 端侧推理原型。</p>
            </div>
            <span class="project-arrow mono">→</span>
          </a>
        </div>
      </section>

      <section class="section principle">
        <h2>个人原则</h2>
        <blockquote>
          先建立真实的输入与可验证的反馈，再谈自动化、规模化与智能化。
        </blockquote>
        <p>
          我把项目、工程日志和思考文章视为同一件事的不同切面：把过程公开，把结论放回实践中检验。
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .profile-page {
    padding: var(--space-7) 0;
  }
  .profile-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .page-head {
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
  }
  .page-head p {
    max-width: 660px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  .section {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .section p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
  .tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag-grid span {
    padding: 6px 9px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }
  .project-list {
    display: grid;
    gap: 1px;
    border: 1px solid var(--color-border);
    background: var(--color-border);
  }
  .project-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg);
    transition: background var(--transition-fast);
  }
  .project-item:hover {
    background: var(--color-bg-subtle);
  }
  .project-name {
    font-weight: 500;
  }
  .project-item p {
    margin-top: 4px;
    font-size: var(--text-sm);
  }
  .project-arrow {
    color: var(--color-text-tertiary);
  }
  .principle blockquote {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  @media (max-width: 640px) {
    .profile-shell {
      padding: 0 var(--space-4);
    }
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
