---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileNav from '../components/ProfileNav.astro';
import { url } from '../lib/url';
---

<BaseLayout active="about" title="About · JJ Lab" description="JJ 的研究兴趣、构建方向与代表项目。">
  <main class="profile-page">
    <div class="profile-shell">
      <ProfileNav active="about" />

      <header class="page-head">
        <span class="eyebrow mono">/about</span>
        <h1>在系统的交叉地带构建与记录。</h1>
        <p>
          我关注 AI Agent、智能硬件、光电感知与产业研究，尝试把不确定的问题拆成可验证、可迭代的系统。
        </p>
      </header>

      <section class="section">
        <h2>研究兴趣</h2>
        <p>
          我尤其关注端侧 AI、近红外光谱传感、多 Agent 工作流，以及 AI 如何帮助研究与决策。兴趣不止于模型本身，也包括数据、工具、状态管理与人如何参与系统闭环。
        </p>
      </section>

      <section class="section">
        <h2>当前能力栈</h2>
        <div class="tag-grid mono" aria-label="技能关键词">
          <span>Python</span>
          <span>LangGraph</span>
          <span>LLM Agents</span>
          <span>ESP32-S3</span>
          <span>TinyML</span>
          <span>NIR Sensing</span>
          <span>Playwright</span>
          <span>Data Pipeline</span>
        </div>
      </section>

      <section class="section">
        <h2>代表项目</h2>
        <div class="project-list">
          <a href={url('/projects/county-research-ai')} class="project-item">
            <div>
              <span class="project-name">CountyResearchAI</span>
              <p>基于多 Agent 架构的县域产业研究自动化系统。</p>
            </div>
            <span class="project-arrow mono">→</span>
          </a>
          <a href={url('/projects/microglow-translate')} class="project-item">
            <div>
              <span class="project-name">MicroGlow Translate</span>
              <p>探索近红外传感、端侧推理与低功耗智能硬件的实验项目。</p>
            </div>
            <span class="project-arrow mono">→</span>
          </a>
        </div>
      </section>

      <section class="section principle">
        <h2>个人原则</h2>
        <blockquote>
          先建立真实的输入与可验证的反馈，再谈自动化、规模化与智能化。
        </blockquote>
        <p>
          我把项目、工程日志和思考文章视为同一件事的不同切面：把过程公开，把结论放回实践中检验。
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .profile-page {
    padding: var(--space-7) 0;
  }
  .profile-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .page-head {
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
  }
  .page-head p {
    max-width: 660px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  .section {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .section p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
  .tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag-grid span {
    padding: 6px 9px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }
  .project-list {
    display: grid;
    gap: 1px;
    border: 1px solid var(--color-border);
    background: var(--color-border);
  }
  .project-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg);
    transition: background var(--transition-fast);
  }
  .project-item:hover {
    background: var(--color-bg-subtle);
  }
  .project-name {
    font-weight: 500;
  }
  .project-item p {
    margin-top: 4px;
    font-size: var(--text-sm);
  }
  .project-arrow {
    color: var(--color-text-tertiary);
  }
  .principle blockquote {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  @media (max-width: 640px) {
    .profile-shell {
      padding: 0 var(--space-4);
    }
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
